# =============================================================================
# NAHOCRAFT - VARIABLES DE ENTORNO (.env.example)
# =============================================================================
# Copia este archivo a `.env.local` para desarrollo local o agrégalas a tu
# panel de hosting (Vercel, Netlify, Cloudflare Pages) para producción.
# =============================================================================

# 1. Correo oficial del centro de arte (notificaciones y contacto)
VITE_ADMIN_EMAIL="Centrodearte@nahocraft.com"

# 2. Contraseña del panel administrativo (/naho)
VITE_ADMIN_PASSWORD="TuContraseñaSegura12#"

# 3. Conexión a Supabase (PostgreSQL + RLS + RPC)
# Obtenidas en: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-public-jwt-key"

# 4. Supabase Storage (Bucket oficial público para medios)
VITE_SUPABASE_STORAGE_BUCKET="nahocraft-media"

# 5. Endpoint de la Edge Function para envío de correos con Nodemailer
# Formato: https://<tu-proyecto>.supabase.co/functions/v1/send-email
VITE_EMAIL_API_ENDPOINT="https://tu-proyecto.supabase.co/functions/v1/send-email"

# =============================================================================
# SECRETOS DE BACKEND (¡NO VAN EN EL FRONTEND NI EN ESTE ARCHIVO!)
# =============================================================================
# Estas variables son exclusivas de la Edge Function en Supabase.
# Se configuran mediante el CLI de Supabase o en el Dashboard:
# Project Settings -> Edge Functions -> Secrets
#
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="465"
#   SMTP_USER="tu-correo@gmail.com"
#   SMTP_PASS="tu-contraseña-de-aplicación-de-16-caracteres"
#   SMTP_FROM="Nahocraft Centro de Arte <tu-correo@gmail.com>"
#
# Comando para configurarlos:
#   pnpm dlx supabase secrets set SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=... SMTP_PASS=...
# =============================================================================

